# postgres
POSTGRES_USER=eis-postgres-user
POSTGRES_PASSWORD=1234567890
POSTGRES_DB=eis
EXPOSE_POSTGRES_PORT=6435

# pgadmin
PGADMIN_DEFAULT_EMAIL=eis-pgadmin@mail.com
PGADMIN_DEFAULT_PASSWORD=1234567890
EXPOSE_PGADMIN_PORT=80

# goose
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# eis
EIS_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
EXPOSE_EIS_PORT=8080
